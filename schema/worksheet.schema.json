
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hong-viet/worksheet.schema.json",
  "title": "Hong Viet Smart Test Worksheet v0.1",
  "description": "Structured curriculum-aligned worksheet data; render math from LaTeX via KaTeX and diagrams from validated SVG primitives. AI must not emit HTML or arbitrary SVG markup.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "subject", "grade", "curriculum", "locale", "page", "questions"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "subject": {"enum": ["math", "vietnamese"]},
    "grade": {"type": "integer", "minimum": 1, "maximum": 5},
    "curriculum": {
      "type": "object", "additionalProperties": false,
      "required": ["framework", "textbookSeries", "topic"],
      "properties": {
        "framework": {"const": "GDPT 2018"},
        "textbookSeries": {"const": "Kết nối tri thức với cuộc sống"},
        "topic": {"type": "string", "minLength": 1},
        "lesson": {"type": "string"},
        "referenceStatus": {"enum": ["teacher_review_required", "verified"], "default": "teacher_review_required"}
      }
    },
    "locale": {"const": "vi-VN"},
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["size", "orientation", "marginMm", "showAnswers"],
      "properties": {
        "size": {"const": "A4"},
        "orientation": {"enum": ["portrait", "landscape"]},
        "marginMm": {"type": "integer", "minimum": 10, "maximum": 25},
        "showAnswers": {"const": false},
        "targetPages": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "questions": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "math": {"type": "object", "additionalProperties": false, "required": ["latex"], "properties": {"latex": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "point": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1000}, "y": {"type": "number", "minimum": 0, "maximum": 1000}}},
    "diagram": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "width", "height", "shapes"],
      "properties": {
        "kind": {"const": "svg-primitives"},
        "width": {"type": "integer", "minimum": 50, "maximum": 1000},
        "height": {"type": "integer", "minimum": 50, "maximum": 1000},
        "shapes": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["type", "x", "y", "width", "height"], "properties": {"type": {"const": "rect"}, "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
          {"type": "object", "additionalProperties": false, "required": ["type", "from", "to"], "properties": {"type": {"const": "line"}, "from": {"$ref": "#/$defs/point"}, "to": {"$ref": "#/$defs/point"}}},
          {"type": "object", "additionalProperties": false, "required": ["type", "at", "text"], "properties": {"type": {"const": "label"}, "at": {"$ref": "#/$defs/point"}, "text": {"type": "string", "maxLength": 80}}}
        ]}}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "difficulty", "prompt", "answerSpaceLines"],
      "properties": {
        "id": {"type": "string", "pattern": "^q[0-9]{2}$"},
        "type": {"enum": ["short_answer", "calculation", "word_problem", "geometry", "multiple_choice"]},
        "difficulty": {"enum": ["easy", "medium", "hard"]},
        "prompt": {"type": "string", "minLength": 1},
        "math": {"$ref": "#/$defs/math"},
        "diagram": {"$ref": "#/$defs/diagram"},
        "options": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"}},
        "answerSpaceLines": {"type": "integer", "minimum": 1, "maximum": 12},
        "points": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "geometry"}}, "required": ["type"]}, "then": {"required": ["diagram"]}},
        {"if": {"properties": {"type": {"const": "multiple_choice"}}, "required": ["type"]}, "then": {"required": ["options"]}}
      ]
    }
  }
}
